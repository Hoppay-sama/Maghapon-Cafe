---
// Landing — hero, brand story, hours & location, featured, testimonials, booking, rewards
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import MenuCard from '../components/MenuCard.astro';
import Testimonials from '../components/Testimonials.astro';
import { menu } from '../data/menu.js';

const featuredIds = [
  'maghapon-latte',
  'sea-salt-cloud-latte',
  'strawberry-matcha',
  'skrambol-latte',
  'salted-cookie',
  'tapa-bowl',
];
const featured = featuredIds.map((id) => menu.find((m) => m.id === id));
const timeSlots = ['2:00 PM', '3:00 PM', '4:00 PM', '5:00 PM', '6:00 PM', '7:00 PM', '8:00 PM', '9:00 PM', '10:00 PM'];
const guestOptions = Array.from({ length: 20 }, (_, i) => i + 1);
---
<Base>
  <Hero />

  <!-- Brand story -->
  <section class="section" id="story">
    <div class="container story-grid">
      <div class="story-media" data-reveal>
        <img src="/images/story.webp" alt="Coffee being prepared at Maghapon Café" width="800" height="1000" />
      </div>
      <div class="story-copy" data-reveal>
        <span class="eyebrow">The name</span>
        <h2>Maghapon — “all day long”</h2>
        <p>
          Rooted in the Filipino word <em>maghapon</em>, which means “all day long” — Maghapon
          invites you to take your time. It's a coffee spot and communal space for both
          unhurried moments and productive days.
        </p>
        <p>
          We open at 2 PM and close at 11 PM, serving espresso classics, ceremonial-grade
          matcha, Filipino-inspired signatures, and food made to share.
        </p>
        <div class="story-facts">
          <div class="fact"><strong>2 PM – 11 PM</strong><span>Open daily · GMT+8</span></div>
          <div class="fact"><strong>Caloocan</strong><span>819 Villa Angelica Subdivision</span></div>
          <div class="fact"><strong>@maghaponcafe</strong><span>IG · FB · TikTok</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Hours & location -->
  <section class="section section-tint" id="visit">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Find us</span>
        <h2>Hours & location</h2>
      </div>
      <div class="grid grid-3">
        <div class="info-card" data-reveal>
          <h3>Open every day</h3>
          <p class="info-big">2 PM – 11 PM</p>
          <p>Afternoon to late evening, Manila time (GMT+8). Come for coffee, stay for dinner.</p>
        </div>
        <div class="info-card" data-reveal>
          <h3>Where we are</h3>
          <p class="info-big">Caloocan City</p>
          <p>819 Villa Angelica Subdivision, Caloocan, 1422 Metro Manila, Philippines.</p>
        </div>
        <div class="info-card" data-reveal>
          <h3>Say hello</h3>
          <p class="info-big">@maghaponcafe</p>
          <p>
            <a href="mailto:maghaponcafe@gmail.com">maghaponcafe@gmail.com</a> · Instagram,
            Facebook, and TikTok.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured ★ items -->
  <section class="section" id="featured">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Customer favorites</span>
        <h2>Start with the stars</h2>
        <p>Six of the most-loved drinks and dishes on our menu — all marked ★ in the full menu.</p>
      </div>
      <div class="grid grid-3">
        {featured.map((item) => <MenuCard item={item} interactive={false} />)}
      </div>
      <p class="center-cta" data-reveal>
        <a class="btn btn-ghost" href="/menu">See the full menu</a>
      </p>
    </div>
  </section>

  <Testimonials />

  <!-- Booking (demo flow) -->
  <section class="section section-tint" id="booking">
    <div class="container booking-grid">
      <div class="booking-media" data-reveal>
        <img src="/images/coffee-3.webp" alt="A cozy table at Maghapon Café" width="800" height="999" />
      </div>
      <div data-reveal>
        <span class="eyebrow">Reserve your spot</span>
        <h2>Book a table or rent the space</h2>
        <p>
          Planning a catch-up, a study session, a small party, or a space rental? Send a request
          and we'll have everything ready when you arrive.
        </p>
        <form class="form-card" id="booking-form">
          <div class="form-grid">
            <div class="field">
              <label for="bk-name">Name</label>
              <input id="bk-name" name="name" required placeholder="Your name" autocomplete="name" />
            </div>
            <div class="field">
              <label for="bk-phone">Phone</label>
              <input id="bk-phone" name="phone" required placeholder="09xx xxx xxxx" autocomplete="tel" />
            </div>
            <div class="field">
              <label for="bk-date">Date</label>
              <input id="bk-date" name="date" type="date" required />
            </div>
            <div class="field">
              <label for="bk-time">Time</label>
              <select id="bk-time" name="time" required>
                {timeSlots.map((slot) => <option value={slot}>{slot}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="bk-guests">Guests</label>
              <select id="bk-guests" name="guests" required>
                {guestOptions.map((n) => <option value={n}>{n}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="bk-type">Event type</label>
              <select id="bk-type" name="type" required>
                <option value="Coffee + chill">Coffee + chill</option>
                <option value="Private event">Private event</option>
                <option value="Space rental">Space rental</option>
              </select>
            </div>
          </div>
          <div class="form-actions">
            <button class="btn btn-primary" type="submit">Request booking</button>
            <span class="checkout-note">We'll confirm within 24 hours. Demo only — no real reservation is made.</span>
          </div>
          <div class="form-success" id="booking-success" role="status"></div>
        </form>
      </div>
    </div>
  </section>

  <!-- Loyalty teaser -->
  <section class="section" id="rewards">
    <div class="container">
      <div class="loyalty-band" data-reveal>
        <div>
          <span class="eyebrow eyebrow-light">Coming soon</span>
          <h2>Maghapon Rewards</h2>
          <p>
            Earn a stamp with every visit and unlock free drinks, birthday treats, and early
            access to limited signatures like the Skrambol Latte.
          </p>
        </div>
        <form class="loyalty-form" id="loyalty-form">
          <input name="name" placeholder="Your name" required aria-label="Your name" />
          <input name="email" type="email" placeholder="Email address" required aria-label="Email address" />
          <button class="btn btn-primary" type="submit">Join the waitlist</button>
          <div class="form-success" id="loyalty-success" role="status"></div>
        </form>
      </div>
    </div>
  </section>

  <script>
    import { saveBookings, saveRewards } from '../lib/cart.js';

    // Earliest bookable date = today in Manila time
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Manila' }).format(new Date());
    document.getElementById('bk-date').min = today;

    document.getElementById('booking-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const f = e.target;
      const bookings = JSON.parse(localStorage.getItem('maghapon-bookings') || '[]');
      bookings.unshift({
        id: 'BK-' + Date.now().toString().slice(-6),
        name: f.name.value.trim(),
        phone: f.phone.value.trim(),
        date: f.date.value,
        time: f.time.value,
        guests: Number(f.guests.value),
        eventType: f.type.value,
        createdAt: new Date().toISOString(),
      });
      saveBookings(bookings);
      const msg = document.getElementById('booking-success');
      msg.textContent = `Booking request received for ${f.date.value} at ${f.time.value} (${f.guests.value} guest${f.guests.value === '1' ? '' : 's'}, ${f.type.value}). We'll confirm within 24 hours.`;
      msg.classList.add('show');
      f.reset();
    });

    document.getElementById('loyalty-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const f = e.target;
      const rewards = JSON.parse(localStorage.getItem('maghapon-rewards') || '[]');
      rewards.push({ name: f.name.value.trim(), email: f.email.value.trim(), createdAt: new Date().toISOString() });
      saveRewards(rewards);
      document.getElementById('loyalty-success').textContent =
        "You're on the list! We'll email you when Maghapon Rewards launches.";
      document.getElementById('loyalty-success').classList.add('show');
      f.reset();
    });
  </script>
</Base>