---
// Landing — order-first: greeting + search + category chips + popular grid,
// then brand story, hours, testimonials, booking, rewards
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import MenuCard from '../components/MenuCard.astro';
import Testimonials from '../components/Testimonials.astro';
import { menu, categories } from '../data/menu.js';

const featuredIds = [
  'maghapon-latte',
  'sea-salt-cloud-latte',
  'strawberry-matcha',
  'skrambol-latte',
  'salted-cookie',
  'tapa-bowl',
  'bacon-carbonara',
  'blueberry-soda',
];

// Product photos for the featured items (mapped to sample assets)
const featuredImages = {
  'maghapon-latte': '/images/products/coffee-1.jpg',
  'sea-salt-cloud-latte': '/images/products/coffee-2.jpg',
  'strawberry-matcha': '/images/products/menu-matcha.jpg',
  'skrambol-latte': '/images/products/coffee-3.jpg',
  'salted-cookie': '/images/products/menu-1.jpg',
  'tapa-bowl': '/images/products/menu-2.jpg',
  'bacon-carbonara': '/images/products/menu-3.jpg',
  'blueberry-soda': '/images/products/menu-classic.jpg',
};
---
<Base>
  <!-- Ordering surface — the first screen -->
  <section class="order-surface">
    <div class="container">
      <h1 class="order-greeting"><span id="greeting">Good day</span>, what are you craving?</h1>
      <p class="order-sub">Order ahead for pickup — we'll have it ready when you arrive.</p>

      <div class="search-box">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input id="order-search" class="search-input" type="search" placeholder="Search coffee, matcha, rice bowls…" aria-label="Search the menu" />
      </div>

      <div class="chip-row" id="category-chips" role="group" aria-label="Filter by category">
        <button type="button" class="chip is-active" data-cat="All" aria-pressed="true">All</button>
        {categories.map((label) => (
          <button type="button" class="chip" data-cat={label} aria-pressed="false">{label}</button>
        ))}
      </div>

      <div class="featured-head">
        <h2>Popular right now</h2>
        <span class="result-count" id="result-count" aria-live="polite">{featuredIds.length} items</span>
      </div>

      <div class="featured-grid" id="featured-grid" data-featured={featuredIds.join(',')}>
        {menu.map((item) => (
          <MenuCard item={item} compact reveal={false} hidden={!featuredIds.includes(item.id)} image={featuredImages[item.id]} />
        ))}
      </div>

      <div class="order-empty" id="order-empty" hidden>
        <p>No matches — try another search.</p>
      </div>
    </div>
  </section>

  <Hero compact />

  <!-- Brand story -->
  <section class="section" id="story">
    <div class="container story-grid">
      <div class="story-media" data-reveal>
        <img src="/images/story.webp" alt="Coffee being prepared at Maghapon Café" width="800" height="1000" />
      </div>
      <div class="story-copy" data-reveal>
        <span class="eyebrow">The name</span>
        <h2>Maghapon — “all day long”</h2>
        <p>
          Rooted in the Filipino word <em>maghapon</em>, which means “all day long” — Maghapon
          invites you to take your time. It's a coffee spot and communal space for both
          unhurried moments and productive days.
        </p>
        <p>
          We open at 2 PM and close at 11 PM, serving espresso classics, ceremonial-grade
          matcha, Filipino-inspired signatures, and food made to share.
        </p>
        <div class="story-facts">
          <div class="fact"><strong>2 PM – 11 PM</strong><span>Open daily · GMT+8</span></div>
          <div class="fact"><strong>Caloocan</strong><span>819 Villa Angelica Subdivision</span></div>
          <div class="fact"><strong>@maghaponcafe</strong><span>IG · FB · TikTok</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Hours & location -->
  <section class="section section-tint" id="visit">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Find us</span>
        <h2>Hours & location</h2>
      </div>
      <div class="grid grid-3">
        <div class="info-card" data-reveal>
          <h3>Open every day</h3>
          <p class="info-big">2 PM – 11 PM</p>
          <p>Afternoon to late evening, Manila time (GMT+8). Come for coffee, stay for dinner.</p>
        </div>
        <div class="info-card" data-reveal>
          <h3>Where we are</h3>
          <p class="info-big">Caloocan City</p>
          <p>819 Villa Angelica Subdivision, Caloocan, 1422 Metro Manila, Philippines.</p>
        </div>
        <div class="info-card" data-reveal>
          <h3>Say hello</h3>
          <p class="info-big">@maghaponcafe</p>
          <p>
            <a href="mailto:maghaponcafe@gmail.com">maghaponcafe@gmail.com</a> · Instagram,
            Facebook, and TikTok.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Testimonials />

  <!-- Booking CTA (the full booking form lives on /booking) -->
  <section class="section section-tint" id="booking">
    <div class="container">
      <div class="booking-cta" data-reveal>
        <div>
          <span class="eyebrow">Reserve your spot</span>
          <h2>Book a table or rent the space</h2>
          <p>
            Catch-ups, study sessions, small parties, or TCG events — send a request and we'll
            have everything ready when you arrive.
          </p>
        </div>
        <a class="btn btn-primary" href="/booking">Book now</a>
      </div>
    </div>
  </section>

  <!-- Loyalty teaser -->
  <section class="section" id="rewards">
    <div class="container">
      <div class="loyalty-band" data-reveal>
        <div>
          <span class="eyebrow eyebrow-light">Coming soon</span>
          <h2>Maghapon Rewards</h2>
          <p>
            Earn a stamp with every visit and unlock free drinks, birthday treats, and early
            access to limited signatures like the Skrambol Latte.
          </p>
        </div>
        <form class="loyalty-form" id="loyalty-form">
          <input name="name" placeholder="Your name" required aria-label="Your name" />
          <input name="email" type="email" placeholder="Email address" required aria-label="Email address" />
          <button class="btn btn-primary" type="submit">Join the waitlist</button>
          <div class="form-success" id="loyalty-success" role="status"></div>
        </form>
      </div>
    </div>
  </section>

  <script>
    import { saveRewards } from '../lib/cart.js';

    // Time-based greeting (visitor's local hour)
    const greeting = document.getElementById('greeting');
    if (greeting) {
      const h = new Date().getHours();
      greeting.textContent = h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening';
    }

    // Ordering surface: search + category chips filter the popular grid
    const grid = document.getElementById('featured-grid');
    const cards = [...grid.querySelectorAll('.menu-card')];
    const featuredSet = new Set(grid.dataset.featured.split(','));
    const chips = [...document.querySelectorAll('#category-chips .chip')];
    const search = document.getElementById('order-search');
    const count = document.getElementById('result-count');
    const empty = document.getElementById('order-empty');
    let category = 'All';
    let query = '';

    function applyFilters() {
      let visible = 0;
      cards.forEach((card) => {
        const catOk = category === 'All' || card.dataset.category === category;
        const qOk = !query || card.dataset.search.includes(query);
        const featuredOnly = category === 'All' && !query;
        const show = catOk && qOk && (!featuredOnly || featuredSet.has(card.dataset.id));
        card.hidden = !show;
        if (show) visible++;
      });
      count.textContent = visible + (visible === 1 ? ' item' : ' items');
      empty.hidden = visible > 0;
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => {
          const active = c === chip;
          c.classList.toggle('is-active', active);
          c.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        category = chip.dataset.cat;
        applyFilters();
      });
    });

    search.addEventListener('input', () => {
      query = search.value.trim().toLowerCase();
      applyFilters();
    });

    applyFilters();

    // Add-to-cart buttons open the item config in the cart drawer
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-add]');
      if (btn && window.maghaponCart) window.maghaponCart.openConfig(btn.dataset.add);
    });

    document.getElementById('loyalty-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const f = e.target;
      const rewards = JSON.parse(localStorage.getItem('maghapon-rewards') || '[]');
      rewards.push({ name: f.name.value.trim(), email: f.email.value.trim(), createdAt: new Date().toISOString() });
      saveRewards(rewards);
      document.getElementById('loyalty-success').textContent =
        "You're on the list! We'll email you when Maghapon Rewards launches.";
      document.getElementById('loyalty-success').classList.add('show');
      f.reset();
    });
  </script>
</Base>