---
// Hero — full-bleed coffee photo, dark overlay, cream text, brand tagline
---
<section class="hero">
  <img
    class="hero-bg"
    src="/images/hero.webp"
    alt="A dark, moody cup of Maghapon coffee"
    width="1080"
    height="1350"
  />
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-content" data-reveal>
      <span class="eyebrow eyebrow-light">Filipino Afternoon Coffee Culture</span>
      <h1>
        Take your time.<br />
        <em>Maghapon</em> is all afternoon.
      </h1>
      <p class="lead">
        A coffee spot and communal space in Caloocan for unhurried moments and productive
        days — open from 2 PM until 11 PM.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/menu">View the menu</a>
        <a class="btn btn-outline" href="/#booking">Book a table</a>
      </div>
      <div class="hero-meta">
        <div><strong>2 PM – 11 PM</strong><span>Open daily · GMT+8</span></div>
        <div><strong>Caloocan</strong><span>Metro Manila</span></div>
        <div><strong>@maghaponcafe</strong><span>IG · FB · TikTok</span></div>
      </div>
    </div>
  </div>
</section>